ate-columns:1fr 1fr}.hour-row{grid-template-columns:62px 52px 1fr}}

/* v0.2 专业命盘 */
.chart-sub{color:var(--muted);margin-bottom:14px}.muted{color:var(--muted)}.paragraph{font-size:13px;line-height:1.75;margin:0}.note-line{margin-top:12px;padding-top:10px;border-top:1px solid var(--line);font-size:11px;line-height:1.65;color:var(--muted)}.version-info{font-size:11px!important;opacity:.85}.strong-warning b{display:inline-block;margin-bottom:4px}
.bazi-table{overflow:hidden;border:1px solid var(--line);border-radius:16px}.bazi-row{display:grid;grid-template-columns:54px repeat(4,minmax(0,1fr));border-bottom:1px solid var(--line)}.bazi-row:last-child{border-bottom:0}.bazi-head{background:var(--bg)}.bazi-label,.bazi-cell{padding:9px 4px;min-width:0}.bazi-label{display:flex;align-items:center;justify-content:center;font-size:10px;color:var(--muted);background:var(--bg);border-right:1px solid var(--line)}.bazi-cell{text-align:center;border-right:1px solid var(--line);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font-size:11px;line-height:1.45}.bazi-cell:last-child{border-right:0}.bazi-cell b{font-size:11px}.big-gz{font-size:23px;line-height:1.1}.bazi-cell small{font-size:9px;color:var(--muted);display:block;margin:0}.hide-stem{display:block;font-size:12px;line-height:1.2;margin:1px 0}.hide-stem small{font-size:8px}
.flow-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin:10px 0 14px}.flow-card{background:var(--bg);border-radius:14px;padding:9px 5px;text-align:center;display:grid;gap:3px}.flow-card b{font-size:9px;color:var(--muted)}.flow-card strong{font-size:17px}.flow-card span{font-size:9px;color:var(--muted)}.flow-card.accent{background:var(--soft)}.relation-block{margin-top:13px}
.dayun-scroll{display:flex;gap:8px;overflow-x:auto;padding:12px 1px 4px;scrollbar-width:none}.dayun-item{position:relative;flex:0 0 92px;background:var(--bg);border:1px solid var(--line);border-radius:15px;padding:10px 7px;text-align:center;display:grid;gap:4px}.dayun-item span,.dayun-item small{font-size:9px;color:var(--muted)}.dayun-item strong{font-size:18px}.dayun-item.current{border-color:var(--accent);box-shadow:inset 0 0 0 1px var(--accent)}.dayun-item i{position:absolute;right:5px;top:5px;font-style:normal;font-size:8px;color:#fff;background:var(--accent);border-radius:999px;padding:2px 4px}
@media(max-width:430px){.bazi-row{grid-template-columns:46px repeat(4,minmax(0,1fr))}.bazi-label,.bazi-cell{padding:8px 2px}.big-gz{font-size:21px}.flow-grid{grid-template-columns:repeat(4,1fr);gap:5px}.flow-card strong{font-size:15px}}

/* v0.3 扶抑分析 */
.beta-tag{display:inline-block;font-size:9px;font-weight:700;color:#fff;background:var(--accent);padding:2px 6px;border-radius:999px;vertical-align:2px;margin-left:5px}
.strength-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin:10px 0 14px}.strength-summary>div,.daily-grid>div{background:var(--bg);border-radius:13px;padding:9px 6px;text-align:center}.strength-summary span,.daily-grid span{display:block;font-size:9px;color:var(--muted);margin-bottom:4px}.strength-summary strong,.daily-grid strong{font-size:12px;line-height:1.45}
.element-bars{display:grid;gap:9px;margin:14px 0}.element-meta{display:grid;grid-template-columns:30px 1fr 46px;align-items:center;font-size:11px}.element-meta span{color:var(--muted)}.element-meta strong{text-align:right}.element-track{height:7px;border-radius:999px;background:var(--bg);overflow:hidden}.element-track i{display:block;height:100%;border-radius:999px;background:var(--accent2)}
.evidence-list{background:var(--bg);border-radius:15px;padding:10px 12px}.evidence-list p{margin:6px 0;font-size:11px;line-height:1.65}.use-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:12px}.use-grid>div{border:1px solid var(--line);border-radius:14px;padding:10px}.use-grid b,.use-grid small{display:block;color:var(--muted);font-size:9px}.use-grid strong{display:block;font-size:18px;margin:5px 0}.color-line{font-size:11px;line-height:1.6;margin-top:10px;padding:9px 11px;background:var(--soft);border-radius:12px}
.daily-balance{margin-top:15px;padding-top:14px;border-top:1px solid var(--line)}.daily-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:7px;margin-bottom:10px}.personal-yi-ji{margin-top:8px}
@media(max-width:430px){.strength-summary{grid-template-columns:repeat(2,1fr)}.use-grid{grid-template-columns:1fr}}

/* v0.4 格局 / 调候 */
.adv-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-bottom:12px}.adv-summary>div,.cross-grid>div{background:var(--bg);border-radius:13px;padding:10px 7px;text-align:center}.adv-summary span,.cross-grid span,.cross-grid small{display:block;font-size:9px;color:var(--muted)}.adv-summary strong{display:block;font-size:12px;line-height:1.45;margin-top:4px}.signal-list{margin-top:10px;padding:9px 11px;border-radius:13px;background:var(--soft)}.signal-list p{font-size:11px;line-height:1.55;margin:4px 0}.cross-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:10px 0}.cross-grid strong{display:block;font-size:20px;margin-bottom:3px}.cross-grid small{margin-top:4px;line-height:1.4}.composite-card .warning b{font-size:14px}
@media(max-width:430px){.adv-summary{grid-template-columns:1fr}.cross-grid{grid-template-columns:repeat(3,1fr)}}
